generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════
// PROJECT & MANUSCRIPT
// ═══════════════════════════════════════════

model Project {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  genre       String   @default("")
  synopsis    String   @default("")
  status      String   @default("draft")
  coverImage  String   @default("")
  settings    String   @default("{}")

  chapters    Chapter[]
  characters  Character[]
  locations   Location[]
  storyObjects StoryObject[]
  timelineEvents TimelineEvent[]
  relationships Relationship[]
  notes       Note[]
  comments    Comment[]
  versions    ManuscriptVersion[]
  goals       WritingGoal[]
  sessions    WritingSession[]
  worldElements WorldElement[]
  agentTasks  AgentTask[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Chapter {
  id        String   @id @default(cuid())
  projectId String
  title     String
  synopsis  String   @default("")
  order     Int      @default(0)
  status    String   @default("draft")
  notes     String   @default("")
  metadata  String   @default("{}")

  scenes    Scene[]
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Scene {
  id        String   @id @default(cuid())
  chapterId String
  title     String
  content   String   @default("")
  order     Int      @default(0)
  status    String   @default("draft")
  povCharacterId String @default("")
  locationId     String @default("")
  timeOfDay     String @default("")
  notes     String   @default("")
  wordCount Int      @default(0)
  metadata  String   @default("{}")

  comments  Comment[]
  versions  ManuscriptVersion[]
  chapter   Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ═══════════════════════════════════════════
// STORY ENTITIES
// ═══════════════════════════════════════════

model Character {
  id          String   @id @default(cuid())
  projectId   String
  name        String
  description String   @default("")
  role        String   @default("")
  age         String   @default("")
  occupation  String   @default("")
  personality String   @default("")
  appearance  String   @default("")
  backstory   String   @default("")
  motivation  String   @default("")
  goals       String   @default("")
  fears       String   @default("")
  tags        String   @default("[]")
  metadata    String   @default("{}")

  relationships Relationship[] @relation("CharacterRelationships")
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Location {
  id          String   @id @default(cuid())
  projectId   String
  name        String
  description String   @default("")
  type        String   @default("")
  atmosphere  String   @default("")
  history     String   @default("")
  features    String   @default("")
  parentLocationId String @default("")
  tags        String   @default("[]")
  metadata    String   @default("{}")

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model StoryObject {
  id          String   @id @default(cuid())
  projectId   String
  name        String
  description String   @default("")
  type        String   @default("")
  owner       String   @default("")
  location    String   @default("")
  history     String   @default("")
  appearance  String   @default("")
  significance String  @default("")
  tags        String   @default("[]")
  metadata    String   @default("{}")

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ═══════════════════════════════════════════
// WORLD BUILDING
// ═══════════════════════════════════════════

model WorldElement {
  id          String   @id @default(cuid())
  projectId   String
  name        String
  description String   @default("")
  category    String   @default("")
  parent      String   @default("")
  rules       String   @default("")
  history     String   @default("")
  tags        String   @default("[]")
  metadata    String   @default("{}")

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ═══════════════════════════════════════════
// TIMELINE
// ═══════════════════════════════════════════

model TimelineEvent {
  id          String   @id @default(cuid())
  projectId   String
  title       String
  description String   @default("")
  date        String   @default("")
  time        String   @default("")
  duration    String   @default("")
  location    String   @default("")
  characters  String   @default("[]")
  objects     String   @default("[]")
  sourceScene String   @default("")
  cause       String   @default("")
  consequence String   @default("")
  eventType   String   @default("")
  tags        String   @default("[]")
  metadata    String   @default("{}")

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ═══════════════════════════════════════════
// RELATIONSHIPS
// ═══════════════════════════════════════════

model Relationship {
  id          String   @id @default(cuid())
  projectId   String
  sourceId    String
  sourceType  String
  targetId    String
  targetType  String
  type        String
  description String   @default("")
  strength    Int      @default(0)
  tags        String   @default("[]")
  metadata    String   @default("{}")

  character   Character? @relation("CharacterRelationships", fields: [sourceId], references: [id])
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ═══════════════════════════════════════════
// NOTES & COMMENTS
// ═══════════════════════════════════════════

model Note {
  id          String   @id @default(cuid())
  projectId   String
  title       String
  content     String   @default("")
  category    String   @default("general")
  linkedType  String   @default("")
  linkedId    String   @default("")
  priority    Int      @default(0)
  resolved    Boolean  @default(false)
  tags        String   @default("[]")
  metadata    String   @default("{}")

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Comment {
  id          String   @id @default(cuid())
  projectId   String
  sceneId     String?
  content     String
  resolved    Boolean  @default(false)
  position    String   @default("{}")
  linkedType  String   @default("")
  linkedId    String   @default("")
  metadata    String   @default("{}")

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scene       Scene?   @relation(fields: [sceneId], references: [id], onDelete: SetNull)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ═══════════════════════════════════════════
// VERSION HISTORY
// ═══════════════════════════════════════════

model ManuscriptVersion {
  id          String   @id @default(cuid())
  projectId   String
  sceneId     String?
  content     String   @default("")
  wordCount   Int      @default(0)
  label       String   @default("")
  isMilestone Boolean  @default(false)
  isAutosave  Boolean  @default(true)
  snapshot    String   @default("{}")
  metadata    String   @default("{}")

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scene       Scene?   @relation(fields: [sceneId], references: [id], onDelete: SetNull)

  createdAt   DateTime @default(now())
}

// ═══════════════════════════════════════════
// WRITING GOALS & ANALYTICS
// ═══════════════════════════════════════════

model WritingGoal {
  id          String   @id @default(cuid())
  projectId   String
  type        String
  target      Int      @default(0)
  current     Int      @default(0)
  deadline    String   @default("")
  active      Boolean  @default(true)
  metadata    String   @default("{}")

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model WritingSession {
  id          String   @id @default(cuid())
  projectId   String
  wordsWritten Int     @default(0)
  duration    Int      @default(0)
  date        String   @default("")
  metadata    String   @default("{}")

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
}

// ═══════════════════════════════════════════
// AI & AGENT
// ═══════════════════════════════════════════

model AgentTask {
  id          String   @id @default(cuid())
  projectId   String   @default("")
  goal        String
  status      String   @default("pending")
  plan        String   @default("[]")
  currentStep Int      @default(0)
  permission  String   @default("suggest")
  toolCalls   String   @default("[]")
  observations String  @default("[]")
  errors      String   @default("[]")
  artifacts   String   @default("[]")
  result      String   @default("")
  metadata    String   @default("{}")

  project     Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
